# Copy to .env locally. Never commit credentials.
PORT=48761
DATA_DIR=.data
CODEX_BIN=/usr/local/bin/codex
MAX_CONCURRENT=2
# Optional model; empty uses the existing Codex configuration.
CODEX_MODEL=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
# Single trusted owner: staffId from your DingTalk organization.
DINGTALK_OWNER_ID=
